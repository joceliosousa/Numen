{

  update;
  delete;

  field ( mandatory : create, readonly : update ) Matnrkit;
  field ( readonly ) Matnr, Omrme, CodigoEmbraer;
  field ( readonly ) Userincl, Useralt, Dataincl, Horaincl, Dataalt, Horaalt, Status;

  determination setControlFields on modify { create; }

  mapping for ztdp_matrmekitma
