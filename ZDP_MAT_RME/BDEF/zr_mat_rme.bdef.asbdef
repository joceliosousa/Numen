      Msdsdoc       = msdsdoc;
      IndAnexMsds   = ind_anex_msds;
      Status        = status;
      Userincl      = userincl;
      Dataincl      = dataincl;
      Horaincl      = horaincl;
      Useralt       = useralt;
      Dataalt       = dataalt;
      Horaalt       = horaalt;
    }

  association _MatRme { with draft; }

}

