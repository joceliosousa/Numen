      Lifnr         = lifnr;
      Werks         = werks;
      Indempa       = indempa;
      Emnfr         = emnfr;
      Sperrfkt      = sperrfkt;
      SperrfktOrig  = sperrfkt_orig;
      Msds          = msds;
