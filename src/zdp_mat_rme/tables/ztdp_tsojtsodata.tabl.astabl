@EndUserText.label : 'ZDPTMM004 - Tabela de Certifica'
@AbapCatalog.enhancement.category : #NOT_EXTENSIBLE
@AbapCatalog.tableCategory : #TRANSPARENT
@AbapCatalog.deliveryClass : #A
@AbapCatalog.dataMaintenance : #RESTRICTED
define table ztdp_tsojtsodata {

  key mandt    : abap.clnt not null;
  key matnr    : matnr not null;
  key certtype : abap.char(4) not null;
  key certnumb : abap.char(15) not null;
  grupo        : abap.char(3);
  dal          : abap.char(30);
  indappro     : abap_boolean;
  userincl     : abap.char(12);
  dataincl     : abap.dats;
  horaincl     : abap.tims;
  useralt      : abap.char(12);
  dataalt      : abap.dats;
  horaalt      : abap.tims;

}
